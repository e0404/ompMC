# A second omc_dosrz build test, taking the input file down the branches the
# smoke deck does not: a point source rather than a pencil, boundaries written
# out in full rather than a uniform count, a spectrum file rather than a single
# energy, a density left to the PEGS file, and the deposited energy rather than
# the dose. Run from the repository root:
#
#   ./build/bin/omc_dosrz -i ucodes/omc_dosrz/coverage_point -o coverage_point
#
# It transports almost nothing on purpose. What it is checking is that these
# keys parse and reach the engine, not what comes out of it.

# start source definition
source type = point
spectrum file = ./spectra/mohan6.spectrum
charge = 0
ssd = 100.0
field radius = 2.0
# A focal spot correlated with the divergence. Said this way rather than as a
# waist, which is a parallel-pencil description and is refused here.
spot sigma = 0.2
divergence sigma = 0.01
correlation = -0.4
# stop source definition

# start MC control
ncase  = 500
nbatch = 2
rng seeds = 97 33
# stop MC control

# start geometry
medium = H2O521ICRU
# No 'medium density': 0 is the sentinel for "whatever PEGS says water
# weighs", and the scorer has to resolve it rather than read it as air.
# Fine rings on the axis and coarse ones outside, which is the whole reason
# the explicit form exists.
radial bin edges = 0.0 0.1 0.2 0.4 0.7 1.2 2.0 3.5 5.0
depth bin edges = 0.0 0.2 0.5 1.0 2.0 4.0 7.0 10.0
# stop geometry

# start MC transport
global ecut = 0.521
global pcut = 0.010
pegs file = ./pegs4/521icru.pegs4dat
pgs4form file = ./pegs4/pgs4form.dat
# stop MC transport

# start VRT
nsplit = 1
esave = 2.0
# stop VRT

# start ompMC environment
output quantity = energy
data folder = ./data/
output folder = ./output/
# stop ompMC environment
